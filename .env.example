# Dominio definitivo al publicarlo (sin barra final)
NEXT_PUBLIC_SITE_URL=

# V2 reseñas — usar un proyecto Supabase EXCLUSIVO para Nexo, no LlevaKí.
# Las claves de abajo deben configurarse SOLO en el servidor (Vercel).
NEXO_SUPABASE_URL=
NEXO_SUPABASE_ANON_KEY=
NEXO_SUPABASE_SERVICE_ROLE_KEY=
# Habilitar solo tras aplicar esquema, configurar claves, validar antispam
# y revisar el aviso de privacidad: true/false
REVIEWS_SUBMISSION_ENABLED=false

# Cloudflare Turnstile (sitio público: site key, secreto SOLO servidor)
NEXT_PUBLIC_REVIEWS_TURNSTILE_SITE_KEY=
REVIEWS_TURNSTILE_SECRET=
